<Project>
  <!-- Shared by every project of the Rentals reference system. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!-- Proof lives beside its owner; only the Proofs project compiles it. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' != 'Proofs'">
    <DefaultItemExcludes>$(DefaultItemExcludes);**/_Tests/**</DefaultItemExcludes>
  </PropertyGroup>
</Project>
